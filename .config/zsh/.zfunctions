#
# ~/.zfunctions
#

# load de funções do zsh
autoload -U zcalc
autoload -Uz tetriscurses

calculadora() {
	zcalc -f -e "$*"
}

# Make dir and cd into it
mkcd() {
    mkdir -p "$1"
    cd "$1"
}

# cd and ls into dir
cl() {
	local dir="$1"
	local dir="${dir:=$HOME}"
	if [[ -d "$dir" ]]; then
		cd "$dir" >/dev/null; ls
	else
		echo "cl: $dir: Directory not found"
	fi
}

# Extract compressed files
extract() {
    local c e i

    (($#)) || return

    for i; do
        c=''
        e=1

        if [[ ! -r $i ]]; then
            echo "$0: file is unreadable: \`$i'" >&2
            continue
        fi

        case $i in
            *.t@(gz|lz|xz|b@(2|z?(2))|a@(z|r?(.@(Z|bz?(2)|gz|lzma|xz)))))
                   c=(bsdtar xvf);;
            *.7z)  c=(7z x);;
            *.Z)   c=(uncompress);;
            *.bz2) c=(bunzip2);;
            *.exe) c=(cabextract);;
            *.gz)  c=(gunzip);;
            *.rar) c=(unrar x);;
            *.xz)  c=(unxz);;
            *.zip) c=(unzip);;
            *)     echo "$0: unrecognized file extension: \`$i'" >&2
                   continue;;
        esac

        command "${c[@]}" "$i"
        ((e = e || $?))
    done
    return "$e"
}

livro() {
    local pasta_livros="$HOME/documents/livros"
    
    if command -v ueberzugpp >/dev/null 2>&1; then
        export UEBERZUG_FIFO="/tmp/ueberzugpp-${$}.fifo"
        rm -f "$UEBERZUG_FIFO"
        mkfifo "$UEBERZUG_FIFO"

        # Inicia a camada do ueberzugpp com parser json no fifo
        ueberzugpp layer --silent --parser json < "$UEBERZUG_FIFO" &
        local uz_pid=$!

        # Mantém a conexão aberta para o fifo não fechar entre comandos
        exec 3>"$UEBERZUG_FIFO"

        cleanup() {
            exec 3>&- 2>/dev/null
            [ -n "$uz_pid" ] && kill "$uz_pid" 2>/dev/null
            rm -f "$UEBERZUG_FIFO" 2>/dev/null
        }
        trap cleanup EXIT INT TERM
    fi

    local arquivo
    arquivo=$(fd -e pdf -e epub . "$pasta_livros" | fzf \
        --preview "$HOME/.local/bin/preview {}" \
        --preview-window="right:50%:wrap" \
        --bind="ctrl-d:preview-page-down,ctrl-u:preview-page-up" \
        --prompt="📖 Livros > ")

    # Limpeza ao sair do fzf
    if [ -n "$uz_pid" ]; then
        # Limpa o preview antes de fechar
        printf '{"action": "remove", "identifier": "fzf-preview"}\n' > "$UEBERZUG_FIFO" 2>/dev/null
        exec 3>&- 2>/dev/null
        kill "$uz_pid" 2>/dev/null
        rm -f "$UEBERZUG_FIFO" 2>/dev/null
        trap - EXIT INT TERM
    fi

    if [[ -n "$arquivo" ]]; then
        swallow zathura "$arquivo"
    fi
}

# Use lf to switch directories and bind it to ctrl-o
lfcd () {
    tmp="$(mktemp -uq)"
    trap 'rm -f $tmp >/dev/null 2>&1 && trap - HUP INT QUIT TERM PWR EXIT' HUP INT QUIT TERM PWR EXIT
    lfub -last-dir-path="$tmp" "$@"
    if [ -f "$tmp" ]; then
        dir="$(cat "$tmp")"
        [ -d "$dir" ] && [ "$dir" != "$(pwd)" ] && cd "$dir"
    fi
}
bindkey -s '^o' '^ulfcd\n'

